# ---------------------------------------------------------------------------
# Copiá este archivo como .env.local para desarrollo local.
# En Vercel: Settings -> Environment Variables (nunca commitear valores reales).
# ---------------------------------------------------------------------------

# --- Postgres de Supabase (schemas bronze / gold) --------------------------
# IMPORTANTE para Vercel: usá el host del POOLER de Supabase, no el directo.
#   Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler"
#   DB_HOST queda tipo: aws-1-sa-east-1.pooler.supabase.com
#   DB_PORT queda 6543  (transaction mode, el que sirve en serverless)
#   DB_USER queda tipo: postgres.<project-ref>
# La conexión directa (db.<ref>.supabase.co:5432) es IPv6 y no funciona
# de forma confiable desde las funciones de Vercel.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=

# --- Supabase Auth (login email/password) ----------------------------------
# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
